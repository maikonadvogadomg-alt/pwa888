{
  "name": "env-bat",
  "version": "1.0.0",
  "description": "env.bat",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "portaDoPrograma": 7749,
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikonadvogadomgalt.envbat.pc",
    "productName": "env.bat",
    "executableName": "env-bat",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "**/*",
      "!android/**",
      "!.github/**",
      "!release/**",
      "!node_modules/.cache/**",
      "!*.zip",
      "!.sk/**",
      "!apk.config.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "env.bat",
      "artifactName": "env-bat-Instalar.exe"
    },
    "portable": {
      "artifactName": "env-bat-sem-instalar.exe"
    }
  }
}
